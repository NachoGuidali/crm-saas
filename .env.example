# ── Django ────────────────────────────────────────────────
# De esta clave se derivan las que cifran los secretos de integraciones (tokens de WhatsApp, Anura, SMTP).
# Guardala y respaldala: si la cambiás, esos secretos guardados dejan de poder descifrarse y hay que recargarlos.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_SETTINGS_MODULE=config.settings.production
# Dominio de la plataforma: el panel queda en midominio.com y cada cliente en cliente.midominio.com
# (DNS: registro A para midominio.com y para *.midominio.com apuntando al servidor).
SAAS_DOMINIO=midominio.com
# El punto inicial habilita todos los subdominios.
ALLOWED_HOSTS=.midominio.com
CSRF_TRUSTED_ORIGINS=https://midominio.com,https://*.midominio.com
# URL del dominio principal. La de cada cliente se arma sola con su subdominio (links, webhooks, media).
SITE_URL=https://midominio.com
CRM_NOMBRE=SupReg CRM
CRM_SUBTITULO=SupReg Solutions
# Si todavía no hay HTTPS, poner False
SECURE_COOKIES=True

# ── Superusuario del panel de la plataforma (solo se crea si no existe ninguno) ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=sistemas@midominio.com
ADMIN_PASSWORD=

# ── Base de datos / Redis ────────────────────────────────
POSTGRES_DB=crm_ventas
POSTGRES_USER=crm_ventas
POSTGRES_PASSWORD=cambiar
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# ── Capacidad ────────────────────────────────────────────
WEB_WORKERS=4
WORKER_CONCURRENCY=4
WORKER_MASIVOS_CONCURRENCY=3

# ── Email (recupero de contraseña y mensajes automáticos) ─
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CRM Ventas <no-responder@midominio.com>

# ── WhatsApp: servidor Evolution compartido por todos los clientes ──
# Cada cliente usa instancias con su prefijo (crm-<schema>-...). Un cliente puede cargar su propio servidor
# en la línea; la clave de acá nunca se le manda a un servidor que no sea este.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=cambiar
EVOLUTION_SERVER_URL=https://evolution.midominio.com

# ── Cobro de la plataforma (ver docs/SAAS.md → Cobros) ──
SAAS_MONEDA=ARS
SAAS_DIAS_AVISO=5            # aviso de vencimiento N días antes (email + cartel en el CRM)
SAAS_DIAS_GRACIA=5           # días después del vencimiento antes de suspender
SAAS_SUSPENDER_VENCIDOS=True
SAAS_EMAIL_AVISOS=True
SAAS_DATOS_PAGO=Alias: mi.alias · CBU 0000000000000000000000 · Titular: Nombre Apellido
SAAS_EMAIL_AVISOS_COPIA=      # tu email, para recibir copia de los avisos
# Home pública: WhatsApp de ventas (botón "Pedir demo"). Solo dígitos, con país y 9. Vacío = oculto.
SAAS_WHATSAPP_VENTAS=549112345678
SAAS_DESCRIPCION=CRM con WhatsApp, telefonía y automatizaciones para equipos de ventas y postventa.
# Mercado Pago (opcional): credenciales de producción y clave secreta de Webhooks
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── Seguridad ─────────────────────────────────────────────
PROXIES_CONFIABLES=1          # cuántos proxies hay delante (nginx = 1). Para tomar la IP real del cliente.
MEDIA_FIRMA_SEGUNDOS=3600     # vigencia de la firma de adjuntos salientes de WhatsApp

# ── Backups (deploy/backup.sh) ────────────────────────────
BACKUP_PASSPHRASE=            # si la ponés, los backups se cifran (AES-256). Guardala aparte del server.
RCLONE_DESTINO=               # ej: "s3remoto:crm-backups" para copiar afuera (rclone config previo)

LOG_RETENTION_DAYS=90

# Supervisión: "Ausente" si no usa el CRM hace N minutos (no cambia el reparto)
PRESENCIA_AUSENTE_MINUTOS=15

# Landing de prueba pública en /demo/formulario/ (solo para demos)
DEMO_LANDING=0
